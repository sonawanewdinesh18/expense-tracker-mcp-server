# Copy this file to .env and fill in your real values.
# Never commit the real .env file to git.

# From Neon Console -> Connection Details (or `neon link`)
DATABASE_URL=postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require

# The public URL this server will be reachable at.
# Local dev:  http://localhost:8000
# Production: https://your-app-name.onrender.com (or your Cloud / Horizon URL)
SERVER_URL=http://localhost:8000

# Port the MCP server listens on (default 8000)
PORT=8000

# Port the optional signup microservice listens on (signup_service.py)
SIGNUP_PORT=8001
